# Root-level .gitignore for Sandesh-Mobile-APP

# IDE and OS files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# Environments and Sensitive Keys
.env
.env.*
*.keystore
*.jks
key.properties
sandesh/android/key.properties

# Gradle / Android / Flutter build and cache outputs (never commit build output)
build/
sandesh/build/
sandesh/android/build/
sandesh/android/app/build/
sandesh/android/.gradle/
.gradle/
sandesh/.dart_tool/
sandesh/.pub/
sandesh/.pub-cache/
sandesh/.flutter-plugins
sandesh/.flutter-plugins-dependencies

# Supabase temporary files
supabase/.temp/
sandesh/supabase/.temp/

# Tool files
.antigravitycli/

